<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath />
    </parent>

    <groupId>rf.stock.agent.service.java</groupId>
    <artifactId>agent-service-java</artifactId>
    <version>1.0.0</version>
    <name>agent-service-java</name>
    <description>Stock Analysis Agent Service – Java/Spring Boot Port</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring WebFlux für SSE (reaktives Streaming) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok – weniger Boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 4 nutzt standardmäßig Jackson 3 (tools.jackson.*,
             JsonMapper statt ObjectMapper). Unser Code (z.B. DataServiceClient)
             erwartet noch die klassische com.fasterxml.jackson.databind.ObjectMapper
             als Bean - dieses offizielle Kompatibilitätsmodul stellt sie wieder
             bereit. Stop-gap laut Spring-Boot-4.0-Migration-Guide; eine echte
             Migration auf Jackson 3 (JsonMapper) ist als separate Aufgabe zu
             planen, dieses Modul wird in einer künftigen Spring-Boot-Version
             entfernt. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- ta4j: Elliott-Wave-Analyse (ElliottWaveFacade) für BearishIndicator,
             seit 23.08. zusätzlich Basis für die bullische Candle-Pattern-
             Erkennung (siehe candle/Ta4jBullishCandlePatterns.java).
             Ersetzt die handgestrickte 5-Wellen-Logik durch ein ausgereiftes,
             szenario-basiertes Modell mit Confidence-Scoring statt hartem
             Pass/Fail. Erfordert Java 25+ (siehe Phase-1-Migration). -->
        <dependency>
            <groupId>org.ta4j</groupId>
            <artifactId>ta4j-core</artifactId>
            <version>0.24.1</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Unter JDK 25 wird Lombok nicht mehr zuverlässig implizit über
                 den Classpath als Annotation-Processor gefunden - deshalb
                 hier explizit als annotationProcessorPath eingetragen
                 (${lombok.version} wird vom Spring-Boot-Parent-POM verwaltet). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>